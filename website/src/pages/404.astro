---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found · PAS-Agent" description="This page doesn't exist.">
  <main id="main" class="not-found">
    <div class="container not-found-inner">
      <p class="text-mono-sm color-accent">404</p>
      <h1 class="text-heading-lg">This page doesn't exist.</h1>
      <p class="text-body color-muted">It may have moved, or the link may be wrong.</p>
      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/docs/introduction" class="btn btn-ghost">Read the docs</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-inner {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .not-found-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
</style>
